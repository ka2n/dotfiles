#!/bin/bash
#
# rofi-keybindings - Display Hyprland keybindings in rofi
#
# Based on omarchy-menu-keybindings from https://github.com/basecamp/omarchy
# Adapted for rofi instead of walker

set -euo pipefail

# Convert modmask number to text representation
# modmask values: SHIFT=1, CTRL=4, ALT=8, SUPER=64
modmask_to_text() {
    local mask="$1"
    case "$mask" in
        0)  echo "" ;;
        1)  echo "Shift" ;;
        4)  echo "Ctrl" ;;
        5)  echo "Shift+Ctrl" ;;
        8)  echo "Alt" ;;
        9)  echo "Shift+Alt" ;;
        12) echo "Ctrl+Alt" ;;
        13) echo "Shift+Ctrl+Alt" ;;
        64) echo "Super" ;;
        65) echo "Super+Shift" ;;
        68) echo "Super+Ctrl" ;;
        69) echo "Super+Shift+Ctrl" ;;
        72) echo "Super+Alt" ;;
        73) echo "Super+Shift+Alt" ;;
        76) echo "Super+Ctrl+Alt" ;;
        77) echo "Super+Shift+Ctrl+Alt" ;;
        *)  echo "Mod${mask}" ;;
    esac
}

# Fetch keybindings from Hyprland and format them (only those with description)
# Output format: "combo → description\tdispatcher\targ"
get_bindings() {
    hyprctl binds -j | jq -r '
        .[] | select(.description | length > 0) |
        [.modmask, .key, .description, .dispatcher, (.arg // "")] |
        @tsv
    ' | while IFS=$'\t' read -r modmask key description dispatcher arg; do
        # Get modifier text
        local mod
        mod=$(modmask_to_text "$modmask")

        # Build key combination
        local combo
        if [[ -n "$mod" ]]; then
            combo="${mod}+${key}"
        else
            combo="${key}"
        fi

        # Output: display text, then tab-separated dispatcher and arg for execution
        printf "%-30s  →  %s\t%s\t%s\n" "$combo" "$description" "$dispatcher" "$arg"
    done
}

# Prioritize common entries for better UX
prioritize_entries() {
    awk '
    {
        line = $0
        prio = 50

        if (/Terminal/) prio = 0
        if (/Browser/) prio = 1
        if (/File manager/) prio = 2
        if (/App launcher/) prio = 3
        if (/Close window/) prio = 8
        if (/Keybindings/) prio = 99

        printf "%d\t%s\n", prio, line
    }' | sort -t$'\t' -k1,1n -k2,2 | cut -f2-
}

# Main
main() {
    local bindings
    bindings=$(get_bindings | sort -u | prioritize_entries)

    if [[ -z "$bindings" ]]; then
        echo "No keybindings found" >&2
        exit 1
    fi

    # Display in rofi - show only first column (before first tab)
    local selected
    selected=$(echo "$bindings" | cut -f1 | rofi -dmenu \
        -p "Keybindings" \
        -i \
        -no-custom \
        -theme-str 'window {width: 60%;}' \
        -theme-str 'listview {lines: 20;}' \
        2>/dev/null) || exit 0

    # Find the matching line and extract dispatcher/arg
    local match
    match=$(echo "$bindings" | grep -F "$selected" | head -1)

    if [[ -n "$match" ]]; then
        local dispatcher arg
        dispatcher=$(echo "$match" | cut -f2)
        arg=$(echo "$match" | cut -f3)

        # Execute the keybinding action
        hyprctl dispatch "$dispatcher" "$arg"
    fi
}

main "$@"
