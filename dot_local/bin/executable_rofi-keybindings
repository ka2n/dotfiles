#!/bin/bash
#
# rofi-keybindings - Display Hyprland keybindings in rofi
#
# Based on omarchy-menu-keybindings from https://github.com/basecamp/omarchy
# Adapted for rofi instead of walker

set -euo pipefail

# Convert modmask number to text representation
# modmask values: SHIFT=1, CTRL=4, ALT=8, SUPER=64
modmask_to_text() {
    local mask="$1"
    case "$mask" in
        0)  echo "" ;;
        1)  echo "Shift" ;;
        4)  echo "Ctrl" ;;
        5)  echo "Shift+Ctrl" ;;
        8)  echo "Alt" ;;
        9)  echo "Shift+Alt" ;;
        12) echo "Ctrl+Alt" ;;
        13) echo "Shift+Ctrl+Alt" ;;
        64) echo "Super" ;;
        65) echo "Super+Shift" ;;
        68) echo "Super+Ctrl" ;;
        69) echo "Super+Shift+Ctrl" ;;
        72) echo "Super+Alt" ;;
        73) echo "Super+Shift+Alt" ;;
        76) echo "Super+Ctrl+Alt" ;;
        77) echo "Super+Shift+Ctrl+Alt" ;;
        *)  echo "Mod${mask}" ;;
    esac
}

# Fetch keybindings from Hyprland and format them
get_bindings() {
    hyprctl binds -j | jq -r '
        .[] |
        [.modmask, .key, (.description // ""), .dispatcher, (.arg // "")] |
        @tsv
    ' | while IFS=$'\t' read -r modmask key description dispatcher arg; do
        # Get modifier text
        local mod
        mod=$(modmask_to_text "$modmask")

        # Build key combination
        local combo
        if [[ -n "$mod" ]]; then
            combo="${mod}+${key}"
        else
            combo="${key}"
        fi

        # Build action description
        local action
        if [[ -n "$description" ]]; then
            action="$description"
        else
            # Clean up the action
            action="${dispatcher}"
            if [[ -n "$arg" ]]; then
                # Clean common prefixes
                local clean_arg="$arg"
                clean_arg="${clean_arg#uwsm app -- }"
                clean_arg="${clean_arg#uwsm-app -- }"
                action="${action}: ${clean_arg}"
            fi
        fi

        # Skip if no action
        [[ -z "$action" ]] && continue

        printf "%-30s  →  %s\n" "$combo" "$action"
    done
}

# Prioritize common entries for better UX
prioritize_entries() {
    awk '
    {
        line = $0
        prio = 50

        # Most common actions at top
        if (/Terminal|alacritty|kitty|wezterm/) prio = 0
        if (/Browser|firefox|chromium|chrome/) prio = 1
        if (/File.*manager|thunar|nautilus|dolphin/) prio = 2
        if (/rofi.*drun|Launch.*app/) prio = 3
        if (/killactive|Close.*window/) prio = 8
        if (/togglefloating/) prio = 9
        if (/fullscreen/) prio = 7

        # Navigation
        if (/movefocus/) prio = 20
        if (/movewindow/) prio = 21
        if (/workspace/) prio = 17
        if (/resizeactive/) prio = 22

        # Lower priority
        if (/XF86/) prio = 99

        printf "%d\t%s\n", prio, line
    }' | sort -t$'\t' -k1,1n -k2,2 | cut -f2-
}

# Main
main() {
    local bindings
    bindings=$(get_bindings | sort -u | prioritize_entries)

    if [[ -z "$bindings" ]]; then
        echo "No keybindings found" >&2
        exit 1
    fi

    # Display in rofi (read-only, just for viewing)
    echo "$bindings" | rofi -dmenu \
        -p "Keybindings" \
        -i \
        -no-custom \
        -theme-str 'window {width: 60%;}' \
        -theme-str 'listview {lines: 20;}' \
        > /dev/null 2>&1 || true
}

main "$@"
