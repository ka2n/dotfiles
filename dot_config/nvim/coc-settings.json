{
  "languageserver": {
    "graphql": {
      "command": "graphql-lsp",
      "args": [
        "server",
        "-m",
        "stream"
      ],
      "filetypes": [
        "typescript",
        "typescriptreact",
        "graphql"
      ],
      "settings": {
        "graphql-config.load.legacy": true
      }
    },
    "bufls": {
      "command": "bufls",
      "rootPatterns": [
        "buf.yaml"
      ],
      "args": [
        "serve"
      ],
      "filetypes": [
        "proto"
      ]
    },
    "terraform": {
      "command": "terraform-ls",
      "filetypes": [
        "terraform",
        "tf"
      ],
      "args": [
        "serve"
      ],
      "initializationOptions": {}
    },
    "efm": {
      "command": "efm-langserver",
      "args": [],
      "filetypes": [
        "markdown"
      ]
    },
    "jsonnet": {
      "command": "jsonnet-language-server",
      "args": [
        "-t"
      ],
      "rootPatterns": [
        ".git/",
        "jsonnetfile.json"
      ],
      "filetypes": [
        "jsonnet",
        "libsonnet"
      ]
    }
  },
  "workspace.rootPatterns": [
    "go.mod",
    ".git"
  ],
  "workspace.workspaceFolderCheckCwd": false,
  "workspace.bottomUpFiletypes": [
    "go"
  ],
  "prettier.embeddedLanguageFormatting": "auto",
  "prettier.onlyUseLocalVersion": true,
  "prettier.formatterPriority": 0,
  "prettier.enableDebugLogs": false,
  "eslint.run": "onSave",
  "eslint.experimental.useFlatConfig": true,
  "biome.requireConfiguration": true,
  "biome.trace.server": "verbose",
  "biome.enable": true,
  "biome.bin": "/home/k2/.local/share/aquaproj-aqua/bin/biome",
  "html.filetypes": [
    "html",
    "handlebars",
    "htmldjango",
    "blade"
  ],
  "codeLens.enable": true,
  "list.insertMappings": {
    "<C-n>": "normal:j",
    "<C-p>": "normal:k"
  },
  "list.normalMappings": {
    "<C-n>": "normal:j",
    "<C-p>": "normal:k"
  },
  "[typescriptreact]": {
    "coc.preferences.formatOnSave": true
  },
  "[typescript]": {
    "coc.preferences.formatOnSave": true
  },
  "[json]": {
    "coc.preferences.formatOnSave": true
  },
  "[yaml]": {
    "coc.preferences.formatOnSave": true
  },
  "[graphql]": {
    "coc.preferences.formatOnSave": true
  },
  "[terraform]": {
    "coc.preferences.formatOnSave": true
  },
  "[ruby]": {
    "coc.preferences.formatOnSave": true
  },
  "[html]": {
    "coc.preferences.formatOnSave": true
  },
  "[liquid]": {
    "coc.preferences.formatOnSave": true
  },
  "[go]": {
    "coc.preferences.formatOnSave": true
  },
  "go.disable": {
    "snippetCompletion": true
  },
  "go.goplsOptions": {
    "usePlaceholders": true
  },
  "diagnostic-languageserver.filetypes": {
    "go": "golangci-lint"
  },
  "yaml.schemaStore.enable": true,
  "diagnostic.warningSign": "",
  "diagnostic.errorSign": "🔴",
  "diagnostic.infoSign": "",
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "solargraph.diagnostics": true,
  "solargraph.hover": true,
  "solargraph.formatting": true,
  "suggest.completionItemKindLabels": {
    "function": "\uf794",
    "method": "\uf6a6",
    "variable": "\uf71b",
    "constant": "\uf8ff",
    "struct": "\ufb44",
    "class": "\uf0e8",
    "interface": "\ufa52",
    "text": "\ue612",
    "enum": "\uf435",
    "enumMember": "\uf02b",
    "color": "\ue22b",
    "property": "\ufab6",
    "field": "\uf93d",
    "unit": "\uf475",
    "file": "\uf471",
    "value": "\uf8a3",
    "event": "\ufacd",
    "folder": "\uf115",
    "keyword": "\uf893",
    "snippet": "\uf64d",
    "operator": "\uf915",
    "reference": "\uf87a",
    "typeParameter": "\uf278",
    "default": "\uf29c"
  }
}
